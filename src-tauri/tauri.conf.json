{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FSHING",
  "mainBinaryName": "FSHING",
  "version": "../package.json",
  "identifier": "com.fshing.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FSHING",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "minimumWebview2Version": "110.0.1587.0",
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "13.3", "signingIdentity": "-" }
  }
}
