{
  "name": "gamecomp-new",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:desktop": "npm run typecheck && vite build --mode desktop",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:mac": "tauri build --bundles app",
    "desktop:windows": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "test:desktop-web": "playwright test --config playwright.desktop.config.ts",
    "test:windows-native": "node scripts/windows-native-smoke.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
